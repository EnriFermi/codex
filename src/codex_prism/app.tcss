Screen { background: $background; color: $foreground; }
#topbar { height: 3; padding: 1 2 0 2; background: $surface; }
#brand { width: 24; color: $accent; text-style: bold; }
#session-status { width: 1fr; text-align: right; color: $text-muted; }
#workspace { height: 1; padding: 0 2; color: $text-muted; background: $surface; }
#main { height: 1fr; }
#sidebar { width: 29; min-width: 20; padding: 1 0; border-right: solid $panel; }
#outline-title { height: 2; padding: 0 2; color: $accent; text-style: bold; }
#filters { height: 3; margin: 0 1 1 1; }
#filters Button { min-width: 5; width: 1fr; padding: 0; border: none; height: 2; background: $panel; }
#filters Button.active { background: $accent; color: $background; }
#outline { height: 1fr; padding: 0 1; border: none; background: $background; }
#outline > .option-list--option { padding: 0 1; }
#outline > .option-list--option-highlighted { background: $panel; }
#sidebar-note { height: auto; padding: 1 2; color: $text-muted; }
#content { width: 1fr; }
#search { height: 3; margin: 0 2; }
#timeline { padding: 1 2; height: 1fr; }
#empty { padding: 3 4; height: auto; color: $text-muted; }
.trace-card { height: auto; margin: 0 0 1 0; padding: 1 2; background: $surface; border-left: thick $panel; }
.trace-card.selected { background: $panel; }
.kind-reasoning { border-left: thick $reasoning; }
.kind-command, .kind-tool, .kind-file { border-left: thick $command; }
.kind-assistant, .kind-commentary { border-left: thick $assistant; }
.kind-user { border-left: thick $user; }
.kind-error { border-left: thick $error; }
.card-heading { height: auto; margin-bottom: 1; }
.card-meta { height: auto; margin-bottom: 1; color: $text-muted; }
.section-label { height: 1; color: $reasoning; margin-bottom: 1; }
.paged { height: auto; }
.page-body { height: auto; overflow-x: auto; }
.message-body, .reasoning-content, .reasoning-summary, .command-body { margin-bottom: 1; }
.pager { height: 3; margin-top: 1; }
.pager Button { min-width: 12; height: 3; }
.page-label { width: 1fr; text-align: center; padding-top: 1; color: $text-muted; }
.output-toggle { width: 1fr; height: 1; min-height: 1; border: none; padding: 0; text-align: left; color: $output; background: transparent; }
.output-toggle:hover { background: $panel; }
.output-preview { height: auto; padding: 1 1 0 1; color: $output; }
.output-notice { height: auto; padding: 1 1 0 1; color: $text-muted; text-style: italic; }
.output-body { margin-top: 1; }
#composer-shell { height: auto; margin: 0 2; border-top: solid $panel; }
#composer-label { height: 1; color: $accent; }
#composer { height: 4; max-height: 12; border: none; background: $surface; }
#hint { height: 1; padding: 0 2; color: $text-muted; }
Footer { background: $surface; }
ModalScreen { align: center middle; background: $background 75%; }
#dialog { width: 85%; height: 85%; padding: 1 2; background: $surface; border: round $accent; }
.dialog-title { height: 2; text-style: bold; color: $accent; }
#dialog VerticalScroll { height: 1fr; }
.dialog-actions { height: 3; align-horizontal: right; }
.dialog-actions Button { margin-left: 1; }
